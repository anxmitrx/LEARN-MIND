rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an authenticated admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'wavelet2026@gmail.com';
    }

    // Rules for 'reservations' collection
    match /reservations/{reservationId} {
      // Allow anyone to submit a reservation with strict type and size bounds
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 8
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.track is string
                    && request.resource.data.track.size() > 0
                    && request.resource.data.track.size() < 50
                    && request.resource.data.status == 'pending'
                    && (request.resource.data.source == 'website' || request.resource.data.source == 'CLI_SMOKE_TEST')
                    && request.resource.data.timestamp is timestamp;

      // Only admin can read, update, or delete reservations
      allow read, update, delete: if isAdmin();
    }

    // Rules for 'consultations' collection
    match /consultations/{consultationId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 8
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.stream is string
                    && request.resource.data.stream.size() > 0
                    && request.resource.data.stream.size() < 50
                    && request.resource.data.timestamp is timestamp;

      allow read, update, delete: if isAdmin();
    }

    // Rules for 'quiz_results' collection
    match /quiz_results/{quizId} {
      // Allow anyone to submit quiz results with validation checks
      allow create: if request.resource.data.educationLevel is string
                    && request.resource.data.educationLevel.size() > 0
                    && request.resource.data.educationLevel.size() < 100
                    && request.resource.data.challenge is string
                    && request.resource.data.challenge.size() > 0
                    && request.resource.data.challenge.size() < 300
                    && request.resource.data.recommendedTrack is string
                    && request.resource.data.recommendedTrack.size() > 0
                    && request.resource.data.recommendedTrack.size() < 100
                    && request.resource.data.timestamp is timestamp;

      // Only admin can read, update, or delete quiz results
      allow read, update, delete: if isAdmin();
    }

    // Rules for 'workshops' collection
    match /workshops/{workshopId} {
      // Anyone can read the public workshops data
      allow read: if true;
      // Only admin can create, update, or delete workshops
      allow create, update, delete: if isAdmin();
    }

    // Rules for 'webinars' collection
    match /webinars/{webinarId} {
      // Anyone can read the public webinars data
      allow read: if true;
      // Only admin can create, update, or delete webinars
      allow create, update, delete: if isAdmin();
    }

    // Rules for 'users' collection
    match /users/{userId} {
      // Allow users to read their own profile, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Allow creating own profile, with size and type safety
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.xp is int
                    && request.resource.data.createdAt is string;
                    
      // Allow updating own profile, preventing privilege/role self-escalation
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.xp is int
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
                    
      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }
  }
}
